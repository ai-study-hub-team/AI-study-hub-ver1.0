# ─── AI Study Hub — Python AI Service ─────────────────────────────────────────
# Copy file này thành .env và điền giá trị thật vào.
# KHÔNG commit file .env vào Git.

# ─── Vector Store Selection ───────────────────────────────────────────────────
# Set to "pgvector" to use PostgreSQL pgvector, or "pinecone" to use Pinecone.
VECTOR_STORE=pgvector

# ─── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ─── Pinecone (optional when VECTOR_STORE=pgvector) ──────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# ─── pgvector PostgreSQL connection ──────────────────────────────────────────
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5433
PGVECTOR_DATABASE=aistudyhub_pgvector_test
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=123456

# ─── Spring Boot Backend ───────────────────────────────────────────────────────
SPRING_BOOT_BASE_URL=http://localhost:8080
